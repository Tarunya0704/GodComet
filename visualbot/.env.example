# Probot / GitHub App credentials.
APP_ID=
# Either inline the PEM (escape newlines as \n) or set PRIVATE_KEY_PATH to a file.
PRIVATE_KEY=
WEBHOOK_SECRET=

# For local development, create a smee channel at https://smee.io/new
# and put the URL here so GitHub webhooks proxy to your laptop.
WEBHOOK_PROXY_URL=

# Probot's HTTP server port (Railway/host).
PORT=3000

# Optional: tell Probot where to log. Defaults to stdout.
LOG_LEVEL=info
