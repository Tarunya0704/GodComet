{
  "name": "visualbot",
  "version": "0.1.0",
  "description": "GitHub App that posts before/after screenshots on PRs with visual changes.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "probot run ./dist/index.js",
    "dev": "npm run build && probot run ./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "probot": "^13.4.0",
    "playwright": "^1.45.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.4",
    "ssim.js": "^3.5.0",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.5.0"
  }
}
